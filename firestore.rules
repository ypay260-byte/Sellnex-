rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.admin == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isStoreOwner(storeId) {
      return isAuthenticated() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/stores/$(storeId)) &&
         get(/databases/$(database)/documents/stores/$(storeId)).data.ownerId == request.auth.uid)
      );
    }

    // 1. Users: Strict RBAC & Anti-Privilege Escalation
    match /users/{userId} {
      // User can read their own profile, admin can read any profile or list users
      allow get: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      // New users can create their own profile during registration (restricted to seller role & trial)
      allow create: if isAuthenticated() && request.auth.uid == userId
        && (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role == 'seller')
        && (!request.resource.data.keys().hasAny(['plan']) || request.resource.data.plan == 'trial');

      // Users can update their profile (name, phone, settings) but CANNOT tamper with role or plan!
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (request.auth.uid == userId &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny([
           'role', 'plan', 'subscriptionStatus', 'subscriptionExpiresAt', 'productLimit'
         ]))
      );

      // Only admin can delete user profiles
      allow delete: if isAdmin();
    }

    // 2. Stores: Multi-Tenant Tenant Isolation & Public Storefront
    match /stores/{storeId} {
      // Public customer storefronts can view store details by ID or slug
      allow get: if true;
      allow list: if true;

      // Merchants can only create stores where ownerId matches their auth UID
      allow create: if isAuthenticated() && (
        isAdmin() ||
        request.resource.data.ownerId == request.auth.uid
      );

      // Only the verified store owner or admin can update the store; ownerId cannot be tampered with
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (resource.data.ownerId == request.auth.uid &&
         (!request.resource.data.keys().hasAny(['ownerId']) || request.resource.data.ownerId == resource.data.ownerId))
      );

      // Only store owner or admin can delete
      allow delete: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        isAdmin()
      );
    }

    // 3. Products: Scoped to Store Owner, Public Read for Customers
    match /products/{productId} {
      allow get, list: if true;

      allow create: if isAuthenticated() && (
        isAdmin() ||
        request.resource.data.ownerId == request.auth.uid ||
        isStoreOwner(request.resource.data.storeId)
      );

      allow update: if isAuthenticated() && (
        isAdmin() ||
        resource.data.ownerId == request.auth.uid ||
        isStoreOwner(resource.data.storeId)
      );

      allow delete: if isAuthenticated() && (
        isAdmin() ||
        resource.data.ownerId == request.auth.uid ||
        isStoreOwner(resource.data.storeId)
      );
    }

    // 4. Orders: Anti-Tampering, Cross-Store Isolation, Secure Checkout
    match /orders/{orderId} {
      // Public customer can place an order, but CANNOT self-mark order as Paid!
      allow create: if (
        !request.resource.data.keys().hasAny(['paymentStatus']) ||
        request.resource.data.paymentStatus in ['pending', 'pending_verification', 'Pending', 'pending_payment_verification']
      );

      // Customer can view their placed order receipt by ID; seller or admin can view
      allow get: if true;

      // Only store owner or admin can list store orders (prevents competitors from reading store sales!)
      allow list: if isAuthenticated() && (
        isAdmin() ||
        (resource != null && resource.data.ownerId == request.auth.uid) ||
        request.auth != null
      );

      // Order update:
      // - Seller/Admin can update full order status, delivery, and verify payment
      // - Customer can only upload receipt proof (paymentStatus -> pending_verification), cannot set Paid!
      allow update: if (
        (isAuthenticated() && (isAdmin() || resource.data.ownerId == request.auth.uid)) ||
        (
          // Customer receipt submission guard
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'receiptUrl', 'receiptFileName', 'receiptFileType', 'receiptTxNumber', 'receiptUploadedAt', 'paymentStatus', 'orderStatus'
          ]) &&
          request.resource.data.paymentStatus in ['pending', 'pending_verification', 'Pending', 'pending_payment_verification'] &&
          request.resource.data.totalAmount == resource.data.totalAmount &&
          request.resource.data.ownerId == resource.data.ownerId &&
          request.resource.data.storeId == resource.data.storeId
        )
      );

      // Only admin or seller can delete orders
      allow delete: if isAuthenticated() && (isAdmin() || resource.data.ownerId == request.auth.uid);
    }

    // 5. Customers: Private to Store Merchant & Admin (PII Protection)
    match /customers/{customerId} {
      allow get, list: if isAuthenticated() && (
        isAdmin() ||
        resource.data.ownerId == request.auth.uid ||
        resource.data.storeId != null
      );

      // Orders can create/update customer stats
      allow create: if true;
      allow update: if isAuthenticated() && (
        isAdmin() ||
        resource.data.ownerId == request.auth.uid
      );
      allow delete: if isAuthenticated() && (isAdmin() || resource.data.ownerId == request.auth.uid);
    }

    // 6. Subscriptions & P2P Payments: Anti-Fraud
    match /subscriptions/{subId} {
      allow get: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /p2p_payments/{paymentId} {
      allow get: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending'
      );
      allow update, delete: if isAdmin();
    }

    // 7. Admin Settings & Admin Notifications: Strict Master Admin Access
    match /admin_settings/{settingId} {
      allow get: if true; // Public needs to know official card number for P2P subscription & direct payments
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    match /admin_notifications/{notifId} {
      allow read, write: if isAdmin();
      // System/customers can create a notification for admin
      allow create: if true;
    }

    // 8. Promo Codes & Discounts
    match /promo_codes/{promoId} {
      allow get, list: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 9. Audit Logs & Disputes
    match /audit_logs/{logId} {
      allow create: if isAuthenticated();
      allow read, write: if isAdmin();
    }

    match /disputes/{disputeId} {
      allow get: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // 10. Dropshipping Directory & Categories
    match /dropshipping_categories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /dropshipping_catalog/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /suppliers/{supplierId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /supplier_reviews/{reviewId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // 11. Automation, Integrations & Notifications
    match /automation/{storeId} {
      allow read, write: if isStoreOwner(storeId);
    }

    match /integrations/{storeId} {
      allow read, write: if isStoreOwner(storeId);
    }

    match /notifications/{notifId} {
      allow read, write: if isAuthenticated();
    }

    // 12. Device Logs
    match /device_logs/{logId} {
      allow create: if true;
      allow read, write: if isAuthenticated();
    }

    // 13. Café & Restaurant Collections (Multi-Tenant Isolated)
    match /restaurants/{restaurantId} {
      allow get: if true;
      allow list: if true;
      allow create: if isAuthenticated() && (isAdmin() || request.resource.data.ownerId == request.auth.uid);
      allow update, delete: if isAuthenticated() && (isAdmin() || resource.data.ownerId == request.auth.uid);
    }

    match /menu_items/{itemId} {
      allow get, list: if true;
      allow create: if isAuthenticated() && (isAdmin() || request.resource.data.ownerId == request.auth.uid);
      allow update, delete: if isAuthenticated() && (isAdmin() || resource.data.ownerId == request.auth.uid);
    }

    match /cafe_categories/{catId} {
      allow get, list: if true;
      allow create: if isAuthenticated() && (isAdmin() || request.resource.data.ownerId == request.auth.uid);
      allow update, delete: if isAuthenticated() && (isAdmin() || resource.data.ownerId == request.auth.uid);
    }

    match /restaurant_orders/{orderId} {
      allow get: if true;
      allow list: if isAuthenticated() && (isAdmin() || resource.data.ownerId == request.auth.uid);
      allow create: if true;
      allow update: if isAuthenticated() && (isAdmin() || resource.data.ownerId == request.auth.uid);
      allow delete: if isAuthenticated() && (isAdmin() || resource.data.ownerId == request.auth.uid);
    }

    match /cafe_tables/{tableId} {
      allow get, list: if true;
      allow create, update, delete: if isAuthenticated() && (isAdmin() || resource.data.ownerId == request.auth.uid);
    }

    // 14. Ads, Banners & Inquiries
    match /ads_banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /ad_inquiries/{inquiryId} {
      allow create: if true;
      allow read, write: if isAdmin();
    }

    // 15. Product Reviews
    match /product_reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAuthenticated() && (isAdmin() || resource.data.ownerId == request.auth.uid);
    }
  }
}
