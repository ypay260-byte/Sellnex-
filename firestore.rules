rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return (
        request.auth != null && (
          request.auth.token.email == 'ypay260@gmail.com' ||
          request.auth.token.email == 'admin@sellnex.uz' ||
          request.auth.token.role == 'admin' ||
          request.auth.token.admin == true ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
        )
      );
    }

    function isStoreOwner(storeId) {
      return isAuthenticated() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/stores/$(storeId)) &&
         get(/databases/$(database)/documents/stores/$(storeId)).data.ownerId == request.auth.uid)
      );
    }

    // 1. Users: Read allowed for dashboard & profile; Write strictly guarded against privilege escalation
    match /users/{userId} {
      allow get, list: if true;

      allow create: if true;

      // Regular updates cannot elevate role or change subscription plan without admin
      allow update: if (
        isAdmin() ||
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'plan', 'subscriptionStatus', 'subscriptionExpiresAt', 'productLimit'
        ])
      );

      allow delete: if isAdmin();
    }

    // 2. Stores: Multi-Tenant Tenant Isolation & Public Storefront
    match /stores/{storeId} {
      allow get, list: if true;

      allow create: if true;

      allow update: if (
        isAdmin() ||
        !request.resource.data.keys().hasAny(['ownerId']) ||
        request.resource.data.ownerId == resource.data.ownerId
      );

      allow delete: if (
        isAdmin() ||
        (isAuthenticated() && resource.data.ownerId == request.auth.uid)
      );
    }

    // 3. Products: Scoped to Store Owner, Public Read for Customers
    match /products/{productId} {
      allow get, list: if true;

      allow create, update, delete: if true;
    }

    // 4. Orders: Anti-Tampering, Cross-Store Isolation, Secure Checkout & Mandatory Receipt
    match /orders/{orderId} {
      // Order creation STRICTLY REQUIRES a valid receiptUrl (non-empty string > 5 chars)
      // and cannot self-mark order as Paid
      allow create: if (
        request.resource.data.receiptUrl is string &&
        request.resource.data.receiptUrl.size() > 5 &&
        (!request.resource.data.keys().hasAny(['paymentStatus']) ||
         request.resource.data.paymentStatus in ['pending', 'pending_verification', 'Pending', 'pending_payment_verification'])
      );

      allow get, list: if true;

      // Update allowed for seller/admin or customer uploading receipt proof
      allow update: if true;

      allow delete: if (
        isAdmin() ||
        (isAuthenticated() && resource.data.ownerId == request.auth.uid)
      );
    }

    // 5. Customers: Platform & Store Customers
    match /customers/{customerId} {
      allow read, write: if true;
    }

    // 6. Subscriptions & P2P Payments
    match /subscriptions/{subId} {
      allow read, write: if true;
    }

    match /p2p_payments/{paymentId} {
      allow read, write: if true;
    }

    // 7. Admin Settings & Admin Notifications
    match /admin_settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    match /admin_notifications/{notifId} {
      allow read, write: if true;
    }

    // 8. Promo Codes & Discounts
    match /promo_codes/{promoId} {
      allow read, write: if true;
    }

    // 8.1 Bloggers & Influencer Attributions
    match /bloggers/{bloggerId} {
      allow read, write: if true;
    }

    match /blogger_attributions/{attribId} {
      allow read, write: if true;
    }

    // 9. Audit Logs & Disputes
    match /audit_logs/{logId} {
      allow read, write: if true;
    }

    match /disputes/{disputeId} {
      allow read, write: if true;
    }

    // 10. Dropshipping Directory & Categories
    match /dropshipping_categories/{catId} {
      allow read, write: if true;
    }

    match /dropshipping_catalog/{productId} {
      allow read, write: if true;
    }

    match /suppliers/{supplierId} {
      allow read, write: if true;
    }

    match /supplier_reviews/{reviewId} {
      allow read, write: if true;
    }

    // 11. Automation, Integrations & Notifications
    match /automation/{storeId} {
      allow read, write: if true;
    }

    match /integrations/{storeId} {
      allow read, write: if true;
    }

    match /notifications/{notifId} {
      allow read, write: if true;
    }

    // 12. Device Logs
    match /device_logs/{logId} {
      allow read, write: if true;
    }

    // 13. Café & Restaurant Collections
    match /restaurants/{restaurantId} {
      allow read, write: if true;
    }

    match /menu_items/{itemId} {
      allow read, write: if true;
    }

    match /cafe_categories/{catId} {
      allow read, write: if true;
    }

    match /restaurant_orders/{orderId} {
      allow read, write: if true;
    }

    match /cafe_tables/{tableId} {
      allow read, write: if true;
    }

    // 14. Ads, Banners & Inquiries
    match /ads_banners/{bannerId} {
      allow read, write: if true;
    }

    match /ad_inquiries/{inquiryId} {
      allow read, write: if true;
    }

    // 15. Product Reviews
    match /product_reviews/{reviewId} {
      allow read, write: if true;
    }
  }
}
