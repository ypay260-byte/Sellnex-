rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Customer Order Receipts: Allow uploading proof of payment up to 10MB (images or PDF)
    match /receipts/{orderId}/{fileName} {
      allow read: if true;
      allow write: if request.resource.size < 10 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
    }

    // P2P Subscription Receipts
    match /p2p_receipts/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.resource.size < 10 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
    }

    // Merchant Store, Product & Cafe Media (Images up to 10MB)
    match /products/{storeId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /stores/{storeId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /cafes/{cafeId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.resource.size < 10 * 1024 * 1024;
    }

    // General fallback: Authenticated write only, public read for CDN images
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.resource.size < 15 * 1024 * 1024;
    }
  }
}
